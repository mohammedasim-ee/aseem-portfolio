# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Your AI provider API key (server-side only, never sent to the browser).
AI_API_KEY=

# Model name for the AI provider.
AI_MODEL=claude-sonnet-4-6

# --- Contact form email sending (optional) ---
# Get a free API key at https://resend.com (no credit card needed).
# Without these two set, the contact form automatically falls back to
# opening the visitor's email app instead of sending silently - it never
# just breaks.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
